# Copie para .env e preencha com as chaves reais. Nunca commitar .env.

PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

# Opcional: item de outra conexão Pluggy de onde só o cartão de crédito
# deve ser sincronizado (ex.: cônjuge 2º titular da mesma conta corrente --
# a conta BANK dela é ignorada de propósito pra não dobrar o saldo, ver
# sync.py:sincronizar_cartao_apenas_credito).
PLUGGY_ITEM_ID_ESPOSA=

# Opcional: outras contas próprias do usuário (ex.: Nubank, Mercado Pago),
# sincronizadas por completo (conta + cartão), separadas por vírgula.
PLUGGY_ITEM_IDS_EXTRAS=

EMAIL_IMAP_USER=
EMAIL_IMAP_APP_PASSWORD=

# Bot criado via @BotFather (/newbot). Chat ID: mande uma mensagem pro bot e
# acesse https://api.telegram.org/bot<TOKEN>/getUpdates -- pegue "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
